{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alssaedy-clinic",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "."
  },
  "migrations": [
    { "tag": "v1", "new_classes": ["ThemeStore"] },
    { "tag": "v2", "deleted_classes": ["ThemeStore"] }
  ],
  "observability": {
    "enabled": true
  }
}
